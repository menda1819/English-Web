# ==============================================================================
# BRIGHT ENGLISH GARDEN - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit .env.local or expose production secrets to browser code.

# Remote MongoDB Atlas connection string (Never use localhost or desktop-only Compass)
# Format: mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_URI=

# 32+ character random secret for signing and verifying secure HTTP-only session cookies
# Generate one with: openssl rand -base64 32
JWT_SECRET=bright_english_garden_super_secret_jwt_key_at_least_32_characters_long!

# Initial Teacher Admin Setup (Used by `npm run seed:teacher` or initial setup script)
INITIAL_TEACHER_NAME=
INITIAL_TEACHER_EMAIL=
INITIAL_TEACHER_PASSWORD=

# Object Storage Configuration (Optional Cloudinary - falls back to remote MongoDB GridFS storage adapter)
# Cloudinary Free Tier: 25 monthly credits (~25GB storage / net bandwidth)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public App URL for production redirects and absolute metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000
